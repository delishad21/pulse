# Pulse production settings. On the server this lives at ~/services/pulse/.env
# (mode 600) and is linked into every release. Never commit real values.
# Empty values fall back to the defaults in compose.yaml.

# --- Required secrets ---
PULSE_DB_PASSWORD=replace-with-a-long-random-password
PULSE_WEB_TOKEN=replace-with-a-long-random-web-token
PULSE_SERVICE_TOKEN=replace-with-a-different-long-random-service-token
AUTH_SECRET=replace-with-random-secret
AUTH_URL=https://pulse.delishad.com

# --- Host ports (loopback only) ---
# nginx proxies pulse.delishad.com to the web port; Hermes calls the MCP port.
PULSE_WEB_PORT=3210
PULSE_MCP_HOST_PORT=6061

# --- Accounts ---
# Public registration is disabled by default. Create users from the API
# container with `docker compose -p pulse exec api npm run auth:create-user -w @pulse/api -- <username>`.
PULSE_REGISTRATION_ENABLED=false
PULSE_AUTH_DISABLED=false
# Legacy service identity; user-scoped MCP keys take precedence when configured.
PULSE_DEFAULT_USERNAME=pulse
# Transitional only when claiming an older email-based default account.
PULSE_LEGACY_DEFAULT_USER_EMAIL=
PULSE_DEFAULT_USER_NAME=Pulse User
PULSE_DEFAULT_TIMEZONE=Asia/Singapore

# --- MCP / Hermes ---
# Create a named key in Pulse Settings and paste it here for the MCP/Hermes
# integration. Without it the MCP falls back to the service token.
PULSE_MCP_API_KEY=

# --- Reminder delivery ---
# Hermes uses a signed webhook; a separate Telegram bot can deliver
# independently when Hermes is unavailable.
HERMES_REMINDER_WEBHOOK_URL=http://<hermes-host>:8644/webhooks/pulse-reminder
HERMES_REMINDER_WEBHOOK_SECRET=
TELEGRAM_FALLBACK_BOT_TOKEN=
TELEGRAM_REMINDER_CHAT_ID=
TELEGRAM_REMINDER_THREAD_ID=
REMINDER_POLL_INTERVAL_MS=5000
REMINDER_MAX_ATTEMPTS=8
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional when Expo push security is enabled for the project.
EXPO_ACCESS_TOKEN=

# --- Deprecated (ignored) ---
# Images are now built on the server and tagged pulse-<service>:<commit>.
# These Portainer/Docker Hub overrides are accepted but have no effect.
PULSE_API_IMAGE=
PULSE_WEB_IMAGE=
PULSE_MCP_IMAGE=
PULSE_REMINDER_WORKER_IMAGE=
