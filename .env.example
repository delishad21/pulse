# Copy to .env on the deployment host. Never commit real values.
PULSE_DB_PASSWORD=replace-with-a-long-random-password
PULSE_WEB_TOKEN=replace-with-a-long-random-web-token
PULSE_SERVICE_TOKEN=replace-with-a-different-long-random-service-token
# Create a named key in Pulse Settings and paste it here for the MCP/Hermes
# integration. Existing deployments temporarily fall back to the service token.
PULSE_MCP_API_KEY=
# Portainer-published MCP image and loopback host port for Hermes.
PULSE_MCP_IMAGE=pulse-mcp:local
PULSE_MCP_HOST_PORT=6061
PULSE_REMINDER_WORKER_IMAGE=pulse-reminder-worker:local

# Reminder delivery. Hermes uses a signed webhook and a separate Telegram bot
# can deliver independently when Hermes is unavailable.
HERMES_REMINDER_WEBHOOK_URL=http://100.65.213.1:8644/webhooks/pulse-reminder
HERMES_REMINDER_WEBHOOK_SECRET=
TELEGRAM_FALLBACK_BOT_TOKEN=
TELEGRAM_REMINDER_CHAT_ID=-1004469714848
TELEGRAM_REMINDER_THREAD_ID=3
REMINDER_POLL_INTERVAL_MS=5000
REMINDER_MAX_ATTEMPTS=8
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional when Expo push security is enabled for the project.
EXPO_ACCESS_TOKEN=

# Web is loopback-only; nginx should proxy to this port.
PULSE_WEB_PORT=3210

# Optional image overrides. Leave the local fallbacks for local builds; set
# these to Docker Hub :latest tags on the home server.
PULSE_API_IMAGE=pulse-api:local
PULSE_WEB_IMAGE=pulse-web:local

# Legacy service identity; user-scoped MCP keys take precedence when configured.
PULSE_DEFAULT_USERNAME=pulse
# Transitional only when claiming an older email-based default account.
PULSE_LEGACY_DEFAULT_USER_EMAIL=
PULSE_DEFAULT_USER_NAME=Pulse User
PULSE_DEFAULT_TIMEZONE=Asia/Singapore
AUTH_SECRET=replace-with-random-secret
AUTH_URL=https://pulse.example.com
# Public registration is disabled by default. Create users from the API
# container with `docker compose exec api npm run auth:create-user -w @pulse/api -- <username>`.
PULSE_REGISTRATION_ENABLED=false
PULSE_AUTH_DISABLED=false
