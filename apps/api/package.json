{
  "name": "@pulse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests scripts",
    "auth:create-user": "tsx scripts/create-user.ts",
    "auth:set-password": "tsx scripts/set-password.ts"
  },
  "dependencies": {
    "@pulse/api-client": "*",
    "@pulse/db": "*",
    "@pulse/domain": "*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.1",
    "zod": "^3.25.22"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4",
    "typescript": "^6.0.3"
  }
}
